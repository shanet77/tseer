{
  "name": "@tseer/tseer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "tseer composition root: boots the cordis context and mounts the plugin list. A TypeScript port of nitter (https://github.com/zedeus/nitter). Licensed AGPL-3.0.",
  "bin": {
    "tseer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node ./dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tseer/http-client": "workspace:*",
    "@tseer/kernel": "workspace:*",
    "@tseer/server": "workspace:*",
    "@tseer/twitter-sessions": "workspace:*",
    "cordis": "4.0.0-rc.10"
  }
}
